# LeadFlow: every environment variable the project reads, in one place.
# Safe local defaults, no secrets. Each variable is tagged with what reads it:
#   [compose]     docker-compose.yml. Copy this file to ./.env to override; with no .env the compose defaults apply.
#   [backend]     the FastAPI app, from backend/.env locally (template: backend/.env.example)
#   [tests]       the backend pytest suite, from backend/.env or the shell
#   [entrypoint]  backend/docker-entrypoint.sh, inside the API container only
#   [frontend]    the Next.js app, from frontend/.env.local locally (template: frontend/.env.example)
# In production these are set in the Render and Vercel dashboards (see README "Deployment").

# --- Database ---------------------------------------------------------------
# [backend] SQLAlchemy URL. postgres:// and postgresql:// (Render/Neon) are rewritten to postgresql+psycopg://.
# On Neon, use the DIRECT (non "-pooler") connection string. Compose ignores this and uses its own "db" service.
DATABASE_URL=postgresql+psycopg://leadflow:leadflow@localhost:5433/leadflow
# [tests] Separate test database, created and migrated by the tests; must differ from DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://leadflow:leadflow@localhost:5433/leadflow_test

# --- API --------------------------------------------------------------------
# [backend][compose] Comma-separated browser origins allowed by CORS (the frontend's URL).
CORS_ORIGINS=http://localhost:3000
# [entrypoint] Port uvicorn listens on inside the container (Render injects its own).
PORT=8000

# --- Demo data --------------------------------------------------------------
# [backend][compose] Timezone that defines "today" for the seeded follow-up scenarios.
SEED_TIMEZONE=Asia/Kolkata
# [entrypoint][compose] Seed demo data when the API container starts; skipped if leads already exist.
SEED_ON_STARTUP=true
# [backend][compose] Enables POST /api/demo/reset (header X-Demo-Token) when non-empty. Empty = disabled (404).
# In production use a long random value (e.g. `openssl rand -hex 32`), also stored as a GitHub secret.
DEMO_RESET_TOKEN=

# --- Frontend ---------------------------------------------------------------
# [frontend][compose] API base URL including /api. Inlined into the browser bundle at build time
# (a Docker build arg), so rebuild after changing it. The browser calls it, so use a public URL.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# [frontend][compose] "true" shows the "Demo instance · data resets daily" footer (public demo only).
NEXT_PUBLIC_DEMO_MODE=false
