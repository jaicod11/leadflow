# Backend settings for local development: copy to backend/.env.
# The full list of variables, with what reads each one, is in the root .env.example.

# SQLAlchemy URL. postgres:// and postgresql:// (Render/Neon) are rewritten to postgresql+psycopg://.
# On Neon, use the DIRECT (non "-pooler") connection string.
DATABASE_URL=postgresql+psycopg://leadflow:leadflow@localhost:5433/leadflow
# Comma-separated browser origins allowed by CORS (the frontend's URL).
CORS_ORIGINS=http://localhost:3000

# Timezone that decides what "today" means for the demo follow-ups created by `python -m app.seed`.
SEED_TIMEZONE=Asia/Kolkata
# Enables POST /api/demo/reset (header X-Demo-Token) when non-empty. Empty = disabled (404).
DEMO_RESET_TOKEN=

# Separate database for the test suite (tests/conftest.py creates it and migrates it automatically).
TEST_DATABASE_URL=postgresql+psycopg://leadflow:leadflow@localhost:5433/leadflow_test

# Read only by docker-entrypoint.sh inside the API container (not by the app itself):
# SEED_ON_STARTUP=true   # seed demo data on start-up (skipped when leads exist)
# PORT=8000              # port uvicorn listens on (Render injects its own)
