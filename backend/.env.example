DATABASE_URL=postgresql+psycopg://leadflow:leadflow@localhost:5433/leadflow
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# Timezone that decides what "today" means for the demo follow-ups created by `python -m app.seed`.
SEED_TIMEZONE=Asia/Kolkata

# Separate database for the test suite (tests/conftest.py creates it and migrates it automatically).
TEST_DATABASE_URL=postgresql+psycopg://leadflow:leadflow@localhost:5433/leadflow_test
