# Frontend settings for local development: copy to frontend/.env.local.
# The full list of variables, with what reads each one, is in the root .env.example.

# Auth needs no frontend variables: the API issues the access tokens, and the demo login
# (DEMO_USER_EMAIL / DEMO_USER_PASSWORD) is configured on the backend.

# Base URL of the LeadFlow API, including the /api prefix (a trailing slash is stripped).
# NEXT_PUBLIC_* variables are inlined into the browser bundle at build time, so restart
# `npm run dev` (or rebuild) after changing it. In Docker it is the NEXT_PUBLIC_API_URL build arg;
# in production (Vercel), set it to the Render API URL, e.g. https://leadflow-api.onrender.com/api.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# "true" shows the "Demo instance · data resets daily at 9:00 AM IST" footer (set it on the public demo only).
NEXT_PUBLIC_DEMO_MODE=false
